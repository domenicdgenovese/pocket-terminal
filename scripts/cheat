#!/bin/zsh
# cheat — the pocket terminal reference, printed where you actually need it.
#
#   cheat            everything
#   cheat stuck      you can't type / nothing works   ← start here in a panic
#   cheat where      which machine am I on
#   cheat connect    getting in
#   cheat claude     running Claude Code
#   cheat ask        ready-made one-shot prompts
#   cheat fix        autonomous bug fixing
#   cheat review     checking what it did
#   cheat git        branches, undo, safety
#   cheat tmux       sessions and windows
#   cheat move       getting around projects
#   cheat never      things that will bite you

B=$'\e[1m'; D=$'\e[2m'; C=$'\e[36m'; Y=$'\e[33m'; G=$'\e[32m'; R=$'\e[31m'; N=$'\e[0m'
h()  { print -r -- ""; print -r -- "${B}$1${N}"; print -r -- "" }
c()  { printf "  ${C}%-30s${N} %s\n" "$1" "$2" }
n()  { print -r -- "  ${D}$1${N}" }
w()  { print -r -- "  ${Y}$1${N}" }

stuck() {
  h "CAN'T TYPE / NOTHING HAPPENS"
  c "q   or   Esc"          "scroll mode ate your keyboard — this fixes it"
  n "Yellow [2/2] in the corner = scroll mode. Swiping causes it."
  print -r -- ""
  c "two-finger tap"        "brand new shell, when all else fails"
  n "Then: mosh mac"
  print -r -- ""
  c "force-quit Blink"      "swipe up, flick it away, reopen"
  n "Always works. Nothing on the Mac is lost."
  h "SCREEN LOOKS ALIVE BUT ISN'T"
  n "\"Last contact 47 seconds ago\" at the top = the session died."
  n "Mosh keeps showing the last picture. Two-finger tap, then mosh mac."
  h "CONNECTION REFUSED / TIMED OUT"
  w "1. Open Tailscale on the phone. Toggle it ON. (fixes it 90% of the time)"
  w "2. Is the Mac awake and plugged in?"
  w "3. Still stuck? Once you're in: doctor"
}

where() {
  h "WHICH MACHINE AM I ON?"
  c "blink>"                    "the PHONE — type: mosh mac"
  c "domgenovese@Domenics… %"   "the MAC — you're in"
  c "›  or  >"                  "inside Claude Code — just type your question"
  n "Bottom bar shows MAC when you're on the Mac."
  print -r -- ""
  w "\"could not get canonical name for mac\""
  n "= you typed mosh mac while already on the Mac. You're already there."
}

connect() {
  h "GETTING IN"
  c "mosh mac"              "connect (only works at blink>)"
  c "doctor"                "full health check, plain English"
  c "cheat"                 "this sheet"
  h "IF mosh mac FAILS"
  c "Operation timed out"   "Tailscale VPN is off on the phone"
  c "authFailed"            "key problem — reached the Mac, was rejected"
  c "hangs forever"         "Mac asleep or dead"
}

claude_() {
  h "CLAUDE CODE"
  c "claude"                "full interactive mode"
  c "claude -p \"…\""         "ask once, answer, exit   ← BEST ON PHONE"
  c "claude -c"             "continue last conversation"
  c "claude --help"         "all options"
  h "INSIDE CLAUDE CODE"
  c "/exit"                 "leave Claude, stay on the Mac"
  c "Esc"                   "interrupt what it's doing"
  c "/clear"                "wipe the conversation, start fresh"
  c "@path/to/file"         "point it at a specific file"
  n "-p mode skips all the modifier-key wrestling. Prefer it on a phone."
}

ask() {
  h "READY-MADE ASKS (copy, change the words)"
  n "claude -p \"what's left before DropNote can ship?\""
  n "claude -p \"run the tests and tell me only what fails\""
  n "claude -p \"summarise the last 5 commits in plain english\""
  n "claude -p \"is anything uncommitted or half-finished right now?\""
  n "claude -p \"what did I change today?\""
  n "claude -p \"explain what SLATE does like I've never seen it\""
  h "STATUS FROM YOUR POCKET"
  n "claude -p \"any failing tests, broken builds or stray files? be brief\""
}

fix_() {
  h "AUTONOMOUS BUG FIXING"
  c "fix \"<what's broken>\""  "branch → reproduce → fix → test → commit"
  c "fix -n name \"<bug>\""    "same, you choose the branch name"
  n "Then ctrl-b d and walk away. It keeps working without you."
  h "MAKE IT ACTUALLY WORK"
  w "Say how to REPRODUCE it, not just that it's broken."
  n "good: fix \"Save on roster screen does nothing, iOS 17, no error in log\""
  n "bad:  fix \"leadoff is buggy\""
  n "An exact error or failing test gives it something to verify against."
  n "Without one it will guess, and guessing looks exactly like success."
  h "SAFETY"
  n "Always works on a new branch. Never touches main."
  n "Won't push. You review the diff before anything ships."
  n "If it can't reproduce the bug it stops and tells you, instead of guessing."
}

review() {
  h "WHAT DID IT ACTUALLY DO?"
  c "git log --oneline -10"    "recent commits"
  c "git diff main"            "everything changed vs main"
  c "git status"               "what's uncommitted"
  c "git show"                 "the most recent commit in full"
  c "claude -p \"review my last commit, be critical\""  "second opinion"
  h "KEEP IT / BIN IT"
  c "git checkout main"        "back to safety, changes stay on the branch"
  c "git branch -D <branch>"   "throw the whole attempt away"
  n "Nothing it does is permanent until you merge it yourself."
}

git_() {
  h "GIT, THE SHORT LIST"
  c "git status"               "where am I, what's changed"
  c "git checkout -b fix/thing" "new branch"
  c "git checkout main"        "back to main"
  c "git add -A && git commit -m \"msg\"" "save work"
  c "git stash"                "shove changes aside for now"
  c "git stash pop"            "get them back"
  h "UNDO"
  c "git checkout -- <file>"   "throw away changes to one file"
  c "git reset --soft HEAD~1"  "undo last commit, KEEP the changes"
  w "Avoid git reset --hard from a phone. It deletes work with no undo."
}

sessions() {
  h "SESSIONS (tmux)"
  c "ctrl-b then d"         "detach — WORK KEEPS RUNNING"
  c "mosh mac"              "come back to it later"
  c "tmux ls"               "what sessions exist"
  h "WINDOWS"
  c "ctrl-b then c"         "new window"
  c "ctrl-b then n"         "next window"
  c "ctrl-b then p"         "previous window"
  c "ctrl-b then 0-9"       "jump to window by number"
  c "ctrl-b then ,"         "rename this window"
  h "SCROLLING"
  c "ctrl-b then ["         "enter scroll mode"
  c "q"                     "leave scroll mode  ← the keyboard fix"
  n "On Blink, ctrl is the ^ key in the toolbar above the keyboard."
}

move() {
  h "GETTING AROUND"
  c "cd ~/Documents/DommyOS" "the main workspace"
  c "cd Projects/DropNote"   "a project inside it"
  c "cd -"                   "back where you just were"
  c "ls"                     "what's here"
  c "pwd"                    "where am I"
  h "YOUR PROJECTS"
  n "~/Documents/DommyOS/Projects/DropNote"
  n "~/Documents/DommyOS/Projects/SLATE"
  n "~/Documents/DommyOS/Projects/ContentEngine"
}

never() {
  h "THINGS THAT WILL BITE YOU"
  w "ctrl-c to \"leave\""
  n "Kills whatever is running. To leave, use ctrl-b then d."
  print -r -- ""
  w "Closing Blink to stop something"
  n "Doesn't stop it. The Mac keeps going. That's the point."
  print -r -- ""
  w "Starting long work then letting the Mac sleep or die"
  n "Everything stops. Mac must be awake AND properly charged."
  n "A 20W phone charger is NOT enough — it drains while showing \"AC\"."
  print -r -- ""
  w "Trusting \"all tests pass\" without seeing output"
  n "Ask: claude -p \"run the tests and paste the actual output\""
  print -r -- ""
  w "git reset --hard on a phone"
  n "No undo, no confirmation, and hard to spot the typo on a small screen."
}

all() {
  print -r -- ""
  print -r -- "${G}  POCKET TERMINAL${N}   ${D}cheat stuck|where|connect|claude|ask|fix|review|git|tmux|move|never${N}"
  stuck; where; connect; claude_; ask; fix_; review; git_; sessions; move; never
  print -r -- ""
}

case "${1:-all}" in
  stuck|help|panic) stuck ;;
  where|who)        where ;;
  connect|conn)     connect ;;
  claude|cc)        claude_ ;;
  ask|prompts)      ask ;;
  fix)              fix_ ;;
  review)           review ;;
  git)              git_ ;;
  tmux|sessions)    sessions ;;
  move|cd|nav)      move ;;
  never|dont|warn)  never ;;
  *)                all ;;
esac
