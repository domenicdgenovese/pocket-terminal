#!/usr/bin/env python3
"""pocket-bot — talk to your Mac from Telegram, in plain English.

Send it a sentence and it runs that through Claude Code in the current project.
Send it /run <cmd> and it runs a shell command. Replies come back as text.

SECURITY, stated plainly because this is the whole risk surface:
  - This executes code on your Mac from a chat message. That is the point.
  - It ONLY listens to one chat id (yours). Messages from anywhere else are
    logged and dropped without executing.
  - Destructive-looking commands require a typed confirmation first, because
    on a phone a mis-tap is much likelier than on a keyboard.
  - /pause stops it acting on anything until /resume. /stop kills it outright.
  - It never runs as root and never elevates.

Anyone holding your unlocked phone has a shell on your Mac. Put a passcode on
Telegram (Settings > Privacy and Security > Passcode Lock).
"""

import json, os, re, shlex, subprocess, sys, threading, time, urllib.parse, urllib.request

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".pocket", "telegram.env")
STATE = os.path.join(HOME, ".pocket", "bot-state.json")
LOG = os.path.join(HOME, ".pocket", "bot.log")

# Things worth a second look before they run unattended from a phone. Not a
# security boundary — a typo guard. Anything genuinely hostile would be typed
# deliberately, and the chat allowlist is what defends against that.
DANGEROUS = re.compile(
    r"(\brm\s+-[rf]|\bgit\s+push\b.*(--force|-f)\b|\bgit\s+reset\s+--hard"
    r"|\bdd\b|\bmkfs|\bshutdown\b|\breboot\b|>\s*/dev/|\bchmod\s+-R\b"
    r"|\bbrew\s+uninstall|\bnpm\s+publish|\bgh\s+repo\s+delete)",
    re.I,
)


# Long work runs on threads so the poll loop never stalls. Without this the
# bot goes deaf for the duration of a build — and from the phone, "busy" and
# "dead" look identical, which is the exact ambiguity this setup exists to kill.
JOBS = {}
JOB_LOCK = threading.Lock()
JOB_SEQ = [0]


def start_job(name, fn):
    with JOB_LOCK:
        JOB_SEQ[0] += 1
        jid = JOB_SEQ[0]
        JOBS[jid] = {"name": name, "started": time.time(), "proc": None}

    def wrap():
        try:
            fn(jid)
        except Exception as e:
            say(f"❌ job {jid} crashed: {e}")
        finally:
            with JOB_LOCK:
                JOBS.pop(jid, None)

    threading.Thread(target=wrap, daemon=True).start()
    return jid


def human_since(t):
    d = int(time.time() - t)
    return f"{d}s" if d < 60 else f"{d // 60}m {d % 60}s"


PROJECTS = os.path.join(HOME, "Projects")

# Work does not all live in one folder. DommyOS keeps its own Projects/ dir,
# and a project you cannot reach from the phone may as well not exist — so scan
# every root rather than assuming a single home.
PROJECT_ROOTS = [
    PROJECTS,
    os.path.join(HOME, "Documents", "DommyOS", "Projects"),
]


def project_list():
    """Projects newest-first by last commit. With 60+ repos, alphabetical is
    useless on a phone — what you touched yesterday is what you want now."""
    out = []
    seen = set()
    for i, root in enumerate(PROJECT_ROOTS):
        if not os.path.isdir(root):
            continue
        for d in sorted(os.listdir(root)):
            full = os.path.join(root, d)
            if not os.path.isdir(full) or d.startswith("."):
                continue
            # ~/Projects is one-repo-per-folder, so requiring .git keeps it
            # clean. Curated roots like DommyOS/Projects hold sub-projects of a
            # single repo — DropNote and SLATE have no .git of their own, and
            # excluding them would hide the projects most worth reaching.
            if i == 0 and not os.path.isdir(os.path.join(full, ".git")):
                continue
            if d in seen:      # same name in two roots — first root wins
                continue
            seen.add(d)
            out.append((d, 0, full))

    # One shell invocation per root, not one per repo. File mtimes are useless
    # here — a fresh clone stamps everything with "now", so the sort would
    # claim 60 projects were all touched today.
    stamps = {}
    for root in PROJECT_ROOTS:
        if not os.path.isdir(root):
            continue
        code, blob = run_shell(
            'for d in */; do n="${d%/}"; '
            'printf "%s\\t%s\\n" "$n" '
            '"$(git -C "$n" log -1 --format=%ct 2>/dev/null || echo 0)"; done',
            root, timeout=90)
        for line in blob.splitlines():
            if "\t" in line:
                n, ts = line.split("\t", 1)
                if n not in stamps:
                    stamps[n] = int(ts) if ts.strip().isdigit() else 0
    # Sub-projects have no history of their own; ask the containing repo when
    # its path last changed, so DropNote doesn't sort to the bottom as unknown.
    resolved = []
    for d, _, path in out:
        ts = stamps.get(d, 0)
        if not ts and not os.path.isdir(os.path.join(path, ".git")):
            code, o = run_shell(
                f'git log -1 --format=%ct -- {shlex.quote(os.path.basename(path))} 2>/dev/null',
                os.path.dirname(path), timeout=20)
            if o.strip().isdigit():
                ts = int(o.strip())
        resolved.append((d, ts, path))
    return sorted(resolved, key=lambda x: -x[1])


def project_ready(path):
    """Has this project had its dependencies installed?"""
    if os.path.exists(os.path.join(path, "package.json")):
        return os.path.isdir(os.path.join(path, "node_modules"))
    if os.path.exists(os.path.join(path, "requirements.txt")):
        return os.path.isdir(os.path.join(path, ".venv"))
    return True


def find_project(q):
    """Fuzzy match — exact, then prefix, then substring. Typing full repo names
    on a phone keyboard is exactly the friction worth removing."""
    q = q.strip().lower()
    names = [(d, p) for d, _, p in project_list()]
    for d, p in names:
        if d.lower() == q:
            return [(d, p)]
    pre = [(d, p) for d, p in names if d.lower().startswith(q)]
    if pre:
        return pre
    return [(d, p) for d, p in names if q in d.lower()]


def age(ts):
    if not ts:
        return "?"
    d = int(time.time() - ts)
    if d < 86400:
        return "today"
    if d < 172800:
        return "1d"
    if d < 2592000:
        return f"{d // 86400}d"
    return f"{d // 2592000}mo"


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")


def conf():
    d = {}
    with open(CONF) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                d[k] = v
    return d


C = conf()
TOKEN, CHAT = C["TG_TOKEN"], str(C["TG_CHAT"])
API = f"https://api.telegram.org/bot{TOKEN}"


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {"cwd": os.path.join(HOME, "Projects", "leadoff"), "offset": 0,
                "paused": False, "pending": None}


def save_state(s):
    with open(STATE, "w") as f:
        json.dump(s, f)


def api(method, **params):
    data = urllib.parse.urlencode(params).encode()
    try:
        with urllib.request.urlopen(f"{API}/{method}", data=data, timeout=70) as r:
            return json.load(r)
    except Exception as e:
        log(f"api {method} failed: {e}")
        return {"ok": False}


def say(text, quiet=False):
    # Telegram caps at 4096. Keep the END — errors live there.
    if len(text) > 3900:
        text = "…(trimmed)…\n" + text[-3800:]
    api("sendMessage", chat_id=CHAT, text=text,
        disable_web_page_preview="true",
        disable_notification="true" if quiet else "false")


def _login_env():
    """Resolve the user's real shell environment ONCE.

    Version managers (nvm, pyenv, rbenv) add their shims to PATH from .zshrc,
    so a bare /bin/sh sees no npm or node. The obvious fix — sourcing .zshrc on
    every command — is correct but ruinously slow: loading nvm takes most of a
    second, and anything that shells out per-repo across 60 projects then takes
    minutes. Resolve it once at startup and reuse it.
    """
    try:
        p = subprocess.run(
            ["/bin/zsh", "-lc", "source $HOME/.zshrc >/dev/null 2>&1; env"],
            capture_output=True, text=True, timeout=60)
        env = dict(os.environ)
        for line in p.stdout.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                env[k] = v
        return env
    except Exception:
        return dict(os.environ)


ENV = _login_env()


def run_shell(cmd, cwd, timeout=900):
    """Run a command with the user's real PATH, without re-sourcing .zshrc."""
    try:
        p = subprocess.run(["/bin/zsh", "-c", cmd], cwd=cwd, env=ENV,
                           capture_output=True, text=True, timeout=timeout)
        out = (p.stdout + p.stderr).strip()
        return p.returncode, out
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout // 60} minutes"
    except Exception as e:
        return 1, str(e)


def strip_ansi(s):
    return re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", s)


HELP = """Talk to your Mac.

Just type what you want, in normal English:
  what's failing in the tests?
  commit this with a sensible message
  why is the roster page 500ing?

Commands:
  /run <cmd>    run a shell command directly
  /where        which project am I in
  /cd <path>    switch project
  /projects     your projects, most recent first
  /setup        install this project's dependencies
  /jobs         what's running right now
  /status       is the Mac healthy
  /pause        stop acting on messages
  /resume       start again
  /stop         shut the bot down
  /help         this

Anything not starting with / goes to Claude Code."""


def handle(text, st):
    cwd = st["cwd"]
    t = text.strip()

    if t in ("/help", "/start", "help"):
        return HELP
    if t == "/where":
        return f"📂 {cwd}\n🌿 {run_shell('git rev-parse --abbrev-ref HEAD', cwd)[1]}"
    if t.startswith("/projects") or t.startswith("/ls"):
        show_all = t.endswith(" all")
        rows = project_list()
        if not rows:
            return "no projects in ~/Projects"
        shown = rows if show_all else rows[:18]
        lines = []
        for d, ts, path in shown:
            mark = "" if project_ready(path) else "  ⚙️"
            here = " ←" if path == cwd else ""
            lines.append(f"{d}  ·  {age(ts)}{mark}{here}")
        head = f"{len(rows)} projects" + ("" if show_all else f" · showing {len(shown)} most recent")
        tail = "" if show_all else "\n\n/projects all  for the full list"
        return (head + "\n\n" + "\n".join(lines) + tail +
                "\n\n⚙️ = needs /setup    /cd <name> to switch")
    if t.startswith("/cd "):
        q = t[4:].strip()
        p = os.path.expanduser(q)
        if os.path.isabs(p) and os.path.isdir(p):
            st["cwd"] = p; save_state(st)
            return f"📂 {p}"
        hits = find_project(q)
        if not hits:
            return f"no project matching '{q}'\n\n/projects to see what's there"
        if len(hits) > 1:
            names = "\n".join(d for d, _ in hits[:12])
            return f"{len(hits)} match '{q}':\n\n{names}\n\nBe more specific."
        d, path = hits[0]
        st["cwd"] = path; save_state(st)
        branch = run_shell("git rev-parse --abbrev-ref HEAD", path, timeout=10)[1]
        warn = "" if project_ready(path) else "\n\n⚙️ dependencies not installed — send /setup"
        return f"📂 {d}\n🌿 {branch}{warn}"
    if t == "/status":
        _, out = run_shell("pocket-doctor 2>/dev/null | sed 's/\\x1b\\[[0-9;]*m//g'", HOME)
        return out or "doctor unavailable"
    if t == "/pause":
        st["paused"] = True; save_state(st)
        return "⏸ paused — I'll ignore instructions until /resume"
    if t == "/resume":
        st["paused"] = False; save_state(st)
        return "▶️ resumed"
    if t == "/stop":
        say("🛑 shutting down. Restart from the Mac with: pocket-bot &")
        save_state(st)
        sys.exit(0)

    if st.get("paused"):
        return "⏸ paused. /resume to continue."

    # Confirmation flow for anything destructive.
    pending = st.get("pending")
    if pending:
        st["pending"] = None
        save_state(st)
        if t.lower() in ("yes", "y", "confirm", "do it"):
            code, out = run_shell(pending, cwd)
            return f"{'✅' if code == 0 else '❌'} exit {code}\n\n{strip_ansi(out)[-2500:] or '(no output)'}"
        return "cancelled."

    if t.startswith("/run "):
        cmd = t[5:].strip()
        if DANGEROUS.search(cmd):
            st["pending"] = cmd
            save_state(st)
            return f"⚠️ This looks destructive:\n\n{cmd}\n\nReply YES to run it, anything else cancels."
        def job(jid):
            code, out = run_shell(cmd, cwd)
            body = strip_ansi(out)[-2500:] or "(no output)"
            say(f"{'✅' if code == 0 else '❌'} job {jid} · {cmd[:40]} · exit {code}\n\n{body}")
        jid = start_job(cmd[:40], job)
        return f"⏳ job {jid} started — {cmd[:60]}\nKeep talking, I'll ping when it's done."

    if t == "/setup":
        if os.path.exists(os.path.join(cwd, "package.json")):
            cmd, what = "npm install --no-fund --no-audit", "npm packages"
        elif os.path.exists(os.path.join(cwd, "requirements.txt")):
            cmd, what = "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt", "python packages"
        elif os.path.exists(os.path.join(cwd, "Gemfile")):
            cmd, what = "bundle install", "gems"
        else:
            return "nothing to install here — no package.json, requirements.txt or Gemfile"

        def job(jid):
            code, out = run_shell(cmd, cwd, timeout=1800)
            tail = strip_ansi(out)[-1200:]
            say(f"{'✅' if code == 0 else '❌'} setup {os.path.basename(cwd)} · exit {code}\n\n{tail}")
        start_job(f"setup {os.path.basename(cwd)}", job)
        return f"⚙️ installing {what} in {os.path.basename(cwd)} — I'll ping when done."

    if t in ("/jobs", "/running"):
        with JOB_LOCK:
            if not JOBS:
                return "nothing running"
            return "\n".join(f"⏳ {j} · {v['name']} · {human_since(v['started'])}"
                              for j, v in sorted(JOBS.items()))

    if t.startswith("/"):
        return f"unknown command. /help for the list."

    # Plain English → Claude Code, in the current project.
    say("🤔 thinking…", quiet=True)
    prompt = (
        f"{t}\n\n"
        "(You are being asked this over Telegram from a phone, so the person "
        "cannot see your terminal and cannot easily answer follow-up questions. "
        "Answer in plain text, no markdown tables or code fences. Be brief — "
        "aim for under 150 words unless they asked for detail. If the request "
        "is ambiguous, make a sensible choice and say which you made rather "
        "than asking.)"
    )
    # shlex.quote, not json.dumps — the prompt contains quotes and newlines and
    # goes through a shell. json escaping is not shell escaping.
    def job(jid):
        code, out = run_shell(f"claude -p {shlex.quote(prompt)}", cwd, timeout=1800)
        out2 = strip_ansi(out).strip()
        say(out2[-3500:] if out2 else f"(claude exited {code} with no output)")

    start_job(t[:40], job)
    return None  # the "thinking…" ack above is the only immediate reply


def main():
    if not os.path.exists(CONF):
        print("not set up — run: notify-setup", file=sys.stderr)
        sys.exit(1)
    st = load_state()
    log("bot started")
    say(f"🤖 Connected. In {os.path.basename(st['cwd'])}.\nSend /help for what I can do.")

    while True:
        r = api("getUpdates", offset=st["offset"], timeout=60)
        if not r.get("ok"):
            time.sleep(5)
            continue
        for upd in r.get("result", []):
            st["offset"] = upd["update_id"] + 1
            save_state(st)
            msg = upd.get("message") or upd.get("edited_message")
            if not msg:
                continue
            chat_id = str(msg.get("chat", {}).get("id"))
            text = msg.get("text", "")
            if chat_id != CHAT:
                # Never execute for anyone else. Log it and move on.
                log(f"DROPPED message from unauthorised chat {chat_id}: {text[:80]!r}")
                continue
            if not text:
                continue
            log(f"< {text[:200]}")
            try:
                reply = handle(text, st)
            except SystemExit:
                raise
            except Exception as e:
                reply = f"error: {e}"
                log(f"handler error: {e}")
            if reply:
                say(reply)
                log(f"> {reply[:200]}")


if __name__ == "__main__":
    main()
